{
  "compilerOptions": {
    "target": "ES2017",
    "module": "es6",
    "lib": ["DOM", "ES2018"],
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "removeComments": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false 
  },
}